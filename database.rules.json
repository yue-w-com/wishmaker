{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "wishes": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'wish', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/[^ ]/) && newData.val().length <= 40"
        },
        "wish": {
          ".validate": "newData.isString() && newData.val().matches(/[^ ]/) && newData.val().length <= 200"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['lines', 'speed'])",
      "lines": {
        ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 15"
      },
      "speed": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
      },
      "oldtv": {
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
